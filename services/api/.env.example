APP_NAME=SULY API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Server-side Supabase configuration.
SUPABASE_URL=https://razvryvazmqvvqkzetuo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Required only for trusted server-side writes; never expose this value to Expo/client builds.
SUPABASE_SECRET_KEY=

# Optional OpenAI-compatible provider. The worker exposes ai.respond only when configured and the user has granted ai.provider.run.
# Keep disabled until a provider is deliberately selected; provider usage may incur charges.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=1200
