APP_NAME=SULY API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Exact browser origins as a JSON array; use HTTPS in production.
CORS_ALLOWED_ORIGINS=[]

# Server-side Supabase configuration.
SUPABASE_URL=https://razvryvazmqvvqkzetuo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Required only for trusted server-side writes; never expose this value to Expo/client builds.
SUPABASE_SECRET_KEY=

# Optional server-side AI provider. The worker exposes ai.respond only when configured and the user has granted ai.provider.run.
# OpenAI-compatible: requires AI_API_KEY. Ollama: no API key required; use an internal/private Ollama URL.
# Examples: AI_PROVIDER=openai-compatible / AI_PROVIDER=ollama. Keep disabled until deliberately configured.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=1200


# Task worker and external agent runtime stay disabled until staging security checks pass.
WORKER_ENABLED=false
WORKER_POLL_INTERVAL_SECONDS=2
HERMES_AGENT_ENABLED=false
HERMES_AGENT_ISOLATION_CONFIRMED=false
HERMES_AGENT_BASE_URL=
HERMES_AGENT_API_KEY=
HERMES_AGENT_TIMEOUT_SECONDS=90

# User-owned long-term memory is opt-in and requires migration 20261121220000 to be applied first.
AGENT_MEMORY_ENABLED=false

# Reconciler only stops previously recorded external runs; enable after applying and testing
# the stop-reconciliation migrations in a disposable/staging database.
ENGINE_RECONCILER_ENABLED=false
ENGINE_RECONCILER_INTERVAL_SECONDS=30

# In-process per-user API rate limits (requests per minute); 0 disables a limit.
RATE_LIMIT_CHAT_RESPOND_PER_MINUTE=10
RATE_LIMIT_CHAT_CONVERSATIONS_PER_MINUTE=10
RATE_LIMIT_CHAT_MESSAGES_PER_MINUTE=30
